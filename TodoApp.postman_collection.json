					"name": "Get Todos with Query Filter",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8000/todos?query=milk",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8000",
							"path": [
								"todos"
							],
							"query": [
								{
									"key": "query",
									"value": "milk",
									"description": "Substring filter for todo titles"
