		{
			"name": "Todos - V1",
			"item": [
				{
					"name": "Create Todo (title only)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Buy milk\"\n}"
						},
						"url": {
							"raw": "http://localhost:8000/todos",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8000",
							"path": [
								"todos"
							]
						},
						"description": "Creates a new todo with default done=false"
					},
					"response": []
				},
				{
					"name": "Create Todo (with done=true)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Already completed task\",\n    \"done\": true\n}"
						},
						"url": {
							"raw": "http://localhost:8000/todos",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8000",
							"path": [
								"todos"
							]
						},
						"description": "Creates a new todo with explicit done=true"
					},
					"response": []
				},
				{
					"name": "Update Todo",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Buy milk\",\n    \"done\": true\n}"
						},
						"url": {
							"raw": "http://localhost:8000/todos/:id",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8000",
							"path": [
								"todos",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "your-todo-id-here",
									"description": "UUID of the todo to update"
								}
							]
						},
						"description": "Updates an existing todo (partial update supported)"
					},
					"response": []
				},
				{
					"name": "Get All Todos",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8000/todos",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8000",
							"path": [
								"todos"
							]
						},
						"description": "Returns all todos with items array and total count"
					},
					"response": []
				},
