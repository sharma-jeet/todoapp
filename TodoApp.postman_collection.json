				{
					"name": "Create Todo with Idempotency Key",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Idempotency-Key",
								"value": "abc123",
								"description": "Unique idempotency key"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Unique task\"\n}"
						},
						"url": {
							"raw": "http://localhost:8000/todos",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8000",
							"path": [
								"todos"
							]
						},
						"description": "Creates a todo with idempotency key - duplicate requests return same todo"
					},
					"response": []
				},
				{
					"name": "Create Todo with Idempotency Key (Duplicate)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Idempotency-Key",
								"value": "abc123",
								"description": "Same idempotency key as previous request"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Different title but same key\"\n}"
						},
						"url": {
							"raw": "http://localhost:8000/todos",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8000",
							"path": [
								"todos"
							]
						},
						"description": "Should return 200 with the same todo created by first request (not 201)"
					},
					"response": []
				}
			]
